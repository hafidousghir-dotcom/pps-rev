// revoke.js — RÉVOCATION À DISTANCE (usage privé : ne JAMAIS donner ce dossier aux clients)
// Usage :  node revoke.js add XXXX-XXXX-XXXX-XXXX [note]   | remove XXXX-... | list
// Chaque commande incrémente seq, signe, et réécrit revoked.json (PUBLIC, à publier en HTTPS).
// Les notes restent dans revoked-private.json (PRIVÉ, jamais publié).
const crypto = require('crypto'), fs = require('fs'), path = require('path');
const { PRIVATE_KEY } = require('./keygen.js');
const DIR = process.env.REVOKE_DIR || __dirname;
const PRIV = path.join(DIR, 'revoked-private.json'), PUB = path.join(DIR, 'revoked.json');
const HW = /^[0-9A-F]{4}(-[0-9A-F]{4}){3}$/;
function load() { try { return JSON.parse(fs.readFileSync(PRIV, 'utf8')); } catch (e) { return { seq: 0, items: [] }; } }
function publish(db) {
  db.seq += 1;
  const hwids = db.items.map(x => x.hwid).sort(), issued = new Date().toISOString().slice(0, 10);
  const sig = crypto.sign(null, Buffer.from('PPS-REV1|' + db.seq + '|' + issued + '|' + hwids.join(',')), crypto.createPrivateKey(PRIVATE_KEY)).toString('base64url');
  fs.writeFileSync(PRIV, JSON.stringify(db, null, 2));
  fs.writeFileSync(PUB, JSON.stringify({ v: 1, seq: db.seq, issued, hwids, sig }));
}
if (require.main === module) {
  const [cmd, a, ...rest] = process.argv.slice(2), db = load();
  const hw = String(a || '').trim().toUpperCase();
  if (cmd === 'list') { console.log('seq ' + db.seq + ' — ' + db.items.length + ' appareil(s)'); db.items.forEach(x => console.log(x.hwid + '  ' + x.date + '  ' + (x.note || ''))); }
  else if ((cmd === 'add' || cmd === 'remove') && HW.test(hw)) {
    if (cmd === 'add') { if (!db.items.some(x => x.hwid === hw)) db.items.push({ hwid: hw, note: rest.join(' '), date: new Date().toISOString().slice(0, 10) }); }
    else db.items = db.items.filter(x => x.hwid !== hw);
    publish(db);
    console.log('OK — seq ' + db.seq + ' — ' + db.items.length + ' appareil(s) révoqué(s).\nPubliez maintenant le fichier : ' + PUB + '  (à l\'URL HTTPS configurée)');
  } else { console.error('Usage : node revoke.js add|remove XXXX-XXXX-XXXX-XXXX [note]  |  node revoke.js list'); process.exit(1); }
}
module.exports = { load, publish };
